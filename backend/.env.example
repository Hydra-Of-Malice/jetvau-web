PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jetvau?retryWrites=true&w=majority
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL=noreply@jetvau.com

# Only needed when the frontend/admin run on a different origin than the API (local dev).
# On Vercel all three apps share one domain, so these can be left unset.
# Each may be a comma-separated list.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# Used only by `npm run create-admin` to create the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
